   @MainActor func freeItemCapReached(storage: Storage, context: ModelContext) -> Bool \{\par
       guard !isPro else \{ return false \}\par
       let sid = storage.persistentModelID\par
       let count = (try? context.fetchCount(FetchDescriptor<InventoryItem>(\par
           predicate: #Predicate \{ $0.storage?.persistentModelID == sid \}))) ?? storage.items.count\par
       return count >= Self.freeItemLimit\par
   \}\par
(Use fetchCount so it does not lag. Fallback to storage.items.count only if the fetch throws.)\par
