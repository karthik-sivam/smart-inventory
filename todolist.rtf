    // MARK: - Sign in with Apple\par
\par
    func prepareAppleSignIn() -> String \{\par
        let nonce = randomNonceString()\par
        currentNonce = nonce\par
        return sha256(nonce)\par
    \}\par
\par
    func signInWithApple(authorization: ASAuthorization) async \{\par
        guard\par
            let appleCredential = authorization.credential as? ASAuthorizationAppleIDCredential,\par
            let nonce = currentNonce,\par
            let appleIDToken = appleCredential.identityToken,\par
            let idTokenString = String(data: appleIDToken, encoding: .utf8)\par
        else \{\par
            errorMessage = "Unable to fetch identity token from Apple."\par
            showError = true\par
            return\par
        \}\par
        let firebaseCredential = OAuthProvider.appleCredential(\par
            withIDToken: idTokenString,\par
            rawNonce: nonce,\par
            fullName: appleCredential.fullName\par
        )\par
        isLoading = true\par
        defer \{ isLoading = false \}\par
        do \{\par
            let result = try await Auth.auth().signIn(with: firebaseCredential)\par
            currentUser = result.user\par
            isAuthenticated = true\par
        \} catch \{\par
            handleAuthError(error)\par
        \}\par
    \}\par
\par
    private func randomNonceString(length: Int = 32) -> String \{\par
        let charset: [Character] = Array("0123456789ABCDEFGHIJKLMNOPQRSTUVXYZabcdefghijklmnopqrstuvwxyz-._")\par
        var result = ""\par
        var remainingLength = length\par
        while remainingLength > 0 \{\par
            let randoms: [UInt8] = (0 ..< 16).map \{ _ in\par
                var random: UInt8 = 0\par
                _ = SecRandomCopyBytes(kSecRandomDefault, 1, &random)\par
                return random\par
            \}\par
            randoms.forEach \{ random in\par
                if remainingLength == 0 \{ return \}\par
                if random < charset.count \{\par
                    result.append(charset[Int(random)])\par
                    remainingLength -= 1\par
                \}\par
            \}\par
        \}\par
        return result\par
    \}\par
\par
    private func sha256(_ input: String) -> String \{\par
        let inputData = Data(input.utf8)\par
        let hashedData = SHA256.hash(data: inputData)\par
        return hashedData.compactMap \{ String(format: "%02x", $0) \}.joined()\par
    \}\par
