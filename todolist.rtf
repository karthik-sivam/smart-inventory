Save action (called when Save tapped):
    guard !isSaving else { return }
    isSaving = true
    let soldQty = qty
    let unitPrice = price > 0 ? price : item.sellingPrice
    let unitCost = item.unitCost
    let storageName = item.storage?.name ?? "Unknown"

    // 1. Insert ActivityEvent BEFORE modifying item (convention rule)
    let event = ActivityEvent(
        eventType: "SaleMade",
        itemName: item.name,
        storageName: storageName,
        quantityBefore: item.currentQuantity,
        quantityAfter: item.currentQuantity - soldQty,
        notes: "Sale: \(soldQty.smartFormatted) @ \(currencyManager.formatPrice(unitPrice))"
    )
    modelContext.insert(event)

    // 2. Create SaleEvent
    let sale = SaleEvent(
        item: item,
        itemName: item.name,
        itemSKU: item.sku,
        storageName: storageName,
        category: item.category,
        quantitySold: soldQty,
        pricePerUnit: unitPrice,
        costPerUnit: unitCost,
        notes: notes,
        occurredAt: saleDate
    )
    modelContext.insert(sale)

    // 3. Create InventoryMovement linked to the sale
    let movement = InventoryMovement(
        item: item,
        itemName: item.name,
        itemSKU: item.sku,
        storageName: storageName,
        category: item.category,
        direction: "OUT",
        movementType: MovementTypeOut.saleOut.rawValue,
        quantity: soldQty,
        pricePerUnit: unitPrice,
        notes: "Quick Sale",
        occurredAt: saleDate,
        linkedSaleEventId: sale.id
    )
    modelContext.insert(movement)

    // 4. Deduct stock
    item.currentQuantity -= soldQty
    item.updatedAt = Date()

    // 5. Save
    modelContext.safeSave(context: "QuickSaleSheet")

    // 6. Push to Firestore (fire-and-forget)
    Task {
        await FirestoreManager.shared.pushSaleEvent(sale)
        await FirestoreManager.shared.pushInventoryMovement(movement)
        // Re-push updated item so sellingPrice and currentQuantity sync
        await FirestoreManager.shared.pushItem(item, in: item.storage)
    }

    // 7. Track analytics
    AnalyticsManager.shared.track(.saleRecorded(
        itemId: item.id.uuidString,
        qty: soldQty,
        sellingPrice: unitPrice,
        costPrice: unitCost,
        profit: (unitPrice - unitCost) * soldQty,
        storageId: item.storage?.id.uuidString ?? ""
    ))

    isSaving = false
    dismiss()

onAppear: set sellingPriceText = item.sellingPrice > 0 ? String(format: "%.2f", item.sellingPrice) : ""

Note: The save button's label shows a ProgressView() when isSaving = true.
