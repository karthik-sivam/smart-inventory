static func suggestSalesColumnMapping(headers: [String], sampleRow: [String]) async throws -> [String: String] \{\par
    let headerList = headers.enumerated().map \{ "Column \($0.offset): \\"\($0.element)\\"" \}.joined(separator: ", ")\par
    let sampleList = sampleRow.enumerated().map \{ "Column \($0.offset): \\"\($0.element)\\"" \}.joined(separator: ", ")\par
    let prompt = """\par
    You are mapping spreadsheet columns for a sales import. Available fields: "Item Name", "Quantity", "Price Per Unit", "Date", "Notes", "— Skip —".\par
    Headers: \(headerList)\par
    First data row: \(sampleList)\par
    Reply with ONLY a JSON object mapping column index (as string) to field name. Example: \{"0":"Item Name","1":"Quantity","2":"Price Per Unit","3":"— Skip —"\}\par
    Map every column index. Use "— Skip —" for unrecognised columns.\par
    """\par
    let result = try await shared.callClaude(prompt: prompt, maxTokens: 200)\par
    guard let data = result.data(using: .utf8),\par
          let json = try? JSONSerialization.jsonObject(with: data) as? [String: String] else \{\par
        throw NSError(domain: "AIInventoryService", code: 99, userInfo: [NSLocalizedDescriptionKey: "Could not parse mapping response"])\par
    \}\par
    return json\par
\}\par
