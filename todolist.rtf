    // Apple only provides fullName once -- save it immediately or it is lost forever\par
    if let fullName = appleCredential.fullName,\par
       let givenName = fullName.givenName \{\par
        let displayName = [givenName, fullName.familyName]\par
            .compactMap \{ $0 \}\par
            .joined(separator: " ")\par
        if !displayName.isEmpty \{\par
            let changeRequest = result.user.createProfileChangeRequest()\par
            changeRequest.displayName = displayName\par
            try? await changeRequest.commitChanges()\par
        \}\par
    \}\par
    currentUser = Auth.auth().currentUser  // refresh after profile update\par
\par
This goes directly after:\par
