            let matched = SalesImportField.allCases.first \{ $0.rawValue == fieldName \} ?? .skip\par
            // Only override if AI's suggestion differs or autoDetect said Skip\par
            if columnMapping[index] == .skip || columnMapping[index] == nil \{\par
                columnMapping[index] = matched\par
            \}\par
        \}\par
    \} catch \{\par
        // Silently fall back to autoDetect() result already applied\par
    \}\par
\}\par
