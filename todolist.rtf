        case "SaleMade":\par
            // quantityBefore = stock before sale, quantityAfter = stock after sale\par
            // soldQty = before - after\par
            if let before = quantityBefore, let after = quantityAfter \{\par
                let soldQty = (before - after).smartFormatted\par
                return "Sale recorded: \\(soldQty) sold from \\(storageName)"\par
            \}\par
            return "Sale recorded from \\(storageName)"\par
        case "MovementLogged":\par
            // quantityBefore = stock before, quantityAfter = stock after\par
            if let before = quantityBefore, let after = quantityAfter \{\par
                let change = after - before\par
                let sign = change >= 0 ? "+" : ""\par
                return "Movement: \\(sign)\\(change.smartFormatted) in \\(storageName)"\par
            \}\par
            return "Movement logged in \\(storageName)"\par
        case "BulkCountImported":\par
            return "Bulk count imported in \\(storageName)"\par
        default:\par
            return eventType\par
        \}\par
    \}\par
\par
Note: \\u8594? is the RTF escape for the unicode arrow character →\par
In the actual Swift code write the literal → character, NOT the RTF escape.\par
