ITEM 19 — Add SaleEvent and InventoryMovement Firestore sync
File: AITest/Models/FirestoreManager.swift
Location: Add two new functions after the existing item sync functions.
Change: Add these two functions, following the exact pattern of the existing push/pull functions:

func pushSaleEvent(_ event: SaleEvent) async {
    guard let uid = TeamManager.shared.effectiveUID else { return }
    let ref = db.collection("users").document(uid)
        .collection("saleEvents").document(event.id.uuidString)
    let data: [String: Any] = [
        "id": event.id.uuidString,
        "itemName": event.itemName,
        "itemSKU": event.itemSKU,
        "storageName": event.storageName,
        "category": event.category,
        "quantitySold": event.quantitySold,
        "pricePerUnit": event.pricePerUnit,
        "costPerUnit": event.costPerUnit,
        "notes": event.notes,
        "occurredAt": Timestamp(date: event.occurredAt),
        "createdAt": Timestamp(date: event.createdAt)
    ]
    try? await ref.setData(data)
}

func pushInventoryMovement(_ movement: InventoryMovement) async {
    guard let uid = TeamManager.shared.effectiveUID else { return }
    let ref = db.collection("users").document(uid)
        .collection("inventoryMovements").document(movement.id.uuidString)
    let data: [String: Any] = [
        "id": movement.id.uuidString,
        "itemName": movement.itemName,
        "itemSKU": movement.itemSKU,
        "storageName": movement.storageName,
        "category": movement.category,
        "direction": movement.direction,
        "movementType": movement.movementType,
        "quantity": movement.quantity,
        "pricePerUnit": movement.pricePerUnit,
        "notes": movement.notes,
        "occurredAt": Timestamp(date: movement.occurredAt),
        "createdAt": Timestamp(date: movement.createdAt),
        "linkedSaleEventId": movement.linkedSaleEventId?.uuidString ?? ""
    ]
    try? await ref.setData(data)
}

Note: Pull-from-cloud for SaleEvents and InventoryMovements is deferred to Phase 7B (multi-device sync of historical sales). In Phase 7A, new records are pushed on creation (fire-and-forget) but pull restores only Storages/Items/Counts as before. This keeps the cloud-sync scope minimal and safe for the 7A deadline.

