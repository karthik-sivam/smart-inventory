    "%lld unresolved item%@ will still be saved — stock will not be deducted until linked." : {
      "comment" : "A note that appears below the list of sales, indicating that any unresolved items will be saved but not yet deducted from inventory. The number inside the parentheses is replaced with the actual count of unresolved items.",
      "extractionState" : "manual",
