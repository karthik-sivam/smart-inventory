    "Track every product, ingredient, or supply across all your storage areas — in real time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تتبع كل منتج أو مكون أو إمدادات عبر جميع مناطق التخزين — في الوقت الفعلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verfolgen Sie jedes Produkt, jede Zutat oder jeden Artikel in allen Ihren Lagerbeständen — in Echtzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rastrea cada producto, ingrediente o suministro en todos tus almacenes — en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suivez chaque produit, ingrédient ou fourniture dans tous vos emplacements — en temps réel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अपने सभी स्टोरेज एरिया में हर प्रोडक्ट, इनग्रेडिएंट या सप्लाई को रीयल टाइम में ट्रैक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lacak setiap produk, bahan, atau perlengkapan di semua area gudang Anda — secara real-time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべての保管場所の全商品、材料、備品をリアルタイムで追跡します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನಿಮ್ಮ ಎಲ್ಲಾ ಸ್ಟೋರೇಜ್ ಪ್ರದೇಶಗಳಲ್ಲಿ ಪ್ರತಿ ಉತ್ಪನ್ನ, ಘಟಕಾಂಶ ಅಥವಾ ಸರಬರಾಜನ್ನು ನೈಜ ಸಮಯದಲ್ಲಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങളുടെ എല്ലാ സ്റ്റോറേജ് ഏരിയകളിലുമുള്ള ഓരോ പ്രോഡക്റ്റും, ഇൻഗ്രീഡിയന്റും, സപ്ലൈയും തത്സമയം ട്രാക്ക് ചെയ്യുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acompanhe cada produto, ingrediente ou suprimento em todos os seus armazéns — em tempo real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отслеживайте все товары, ингредиенты или материалы по всем складским помещениям в реальном времени."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "உங்கள் அனைத்து சேமிப்பிடங்களிலும் ஒவ்வொரு பொருள், மூலப்பொருள் அல்லது சப்ளையையும் நிகர நேரத்தில் கண்காணிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీ అన్ని నిల్వ స్థలాల్లో ప్రతి ఉత్పత్తి, పదార్థం లేదా సరుకును రియల్ టైమ్‌లో ట్రాక్ చేయండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "实时追踪所有仓位中的每件商品、原料或物料。"
          }
        }
      }
