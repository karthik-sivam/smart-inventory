    "Edit any item and set a Minimum Quantity. You'll get a push notification when stock drops below that level." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عدّل أي صنف وعيّن الحد الأدنى للكمية. ستتلقى إشعار فوري عندما ينخفض المخزون عن هذا المستوى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bearbeite jeden Artikel und lege eine Mindestmenge fest. Du erhältst eine Push-Benachrichtigung, wenn der Bestand unter diesen Wert fällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Edita cualquier artículo y establece una Cantidad Mínima. Recibirás una notificación cuando el stock caiga por debajo de ese nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Modifiez n'importe quel article et définissez une quantité minimale. Vous recevrez une notification push lorsque le stock descend en dessous de ce niveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी भी आइटम को एडिट करें और न्यूनतम मात्रा सेट करें। स्टॉक उस स्तर से नीचे जाने पर आपको पुश नोटिफ़िकेशन मिलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Edit item apa pun dan atur Kuantitas Minimum. Anda akan menerima notifikasi push saat stok turun di bawah level tersebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "アイテムを編集して最小数量を設定します。在庫がそのレベルを下回るとプッシュ通知が届きます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಯಾವುದೇ ವಸ್ತುವನ್ನು ಸಂಪಾದಿಸಿ ಮತ್ತು ಕನಿಷ್ಠ ಪ್ರಮಾಣವನ್ನು ಹೊಂದಿಸಿ. ದಾಸ್ತಾನು ಆ ಮಟ್ಟಕ್ಕಿಂತ ಕಡಿಮೆಯಾದಾಗ ನಿಮಗೆ ಪುಶ್ ಅಧಿಸೂಚನೆ ಸಿಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഏതെങ്കിലും ഉൽപ്പന്നം എഡിറ്റ് ചെയ്ത് ഒരു മിനിമം ക്വാണ്ടിറ്റി സെറ്റ് ചെയ്യുക. സ്റ്റോക്ക് ആ നിലയ്ക്ക് താഴെ പോകുമ്പോൾ നിങ്ങൾക്ക് ഒരു പുഷ് നോട്ടിഫിക്കേഷൻ ലഭിക്കും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Edite qualquer item e defina uma Quantidade Mínima. Você receberá uma notificação quando o estoque cair abaixo desse nível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отредактируйте товар и установите минимальное количество. Вы получите уведомление, когда запас упадёт ниже этого уровня."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "எந்தப் பொருளையும் திருத்தி குறைந்தபட்ச அளவை அமைக்கவும். சரக்கு அந்த அளவுக்குக் கீழே சென்றால் உங்களுக்கு அறிவிப்பு வரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఏదైనా వస్తువును సవరించి కనీస పరిమాణాన్ని సెట్ చేయండి. స్టాక్ ఆ స్థాయి కంటే తగ్గినప్పుడు మీకు పుష్ నోటిఫికేషన్ వస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "编辑任何商品并设置最低库存量。当库存低于该水平时，您将收到推送通知。"
          }
        }
      }
    },
