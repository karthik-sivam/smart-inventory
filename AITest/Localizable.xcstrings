    "Pro subscriptions auto-renew. Cancel anytime in Settings → Apple ID → Subscriptions." : {
      "comment" : "A footer note explaining that Pro subscriptions automatically renew and can be canceled in the app settings.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اشتراكات Pro تتجدد تلقائياً. ألغِ الاشتراك في أي وقت من الإعدادات → معرّف Apple → الاشتراكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro-Abos werden automatisch erneuert. Jederzeit unter Einstellungen → Apple ID → Abos kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las suscripciones Pro se renuevan automáticamente. Cancela en cualquier momento en Configuración → Apple ID → Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les abonnements Pro se renouvellent automatiquement. Annulez à tout moment dans Paramètres → Apple ID → Abonnements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro सदस्यता स्वचालित रूप से नवीनीकृत होती है। Settings → Apple ID → Subscriptions में किसी भी समय रद्द करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Langganan Pro diperpanjang otomatis. Batalkan kapan saja di Pengaturan → Apple ID → Langganan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro サブスクリプションは自動更新されます。設定 → Apple ID → サブスクリプションからいつでもキャンセルできます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro ಚಂದಾ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನವೀಕರಣಗೊಳ್ಳುತ್ತೆ. ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳು → Apple ID → ಚಂದಾ ರದ್ದುಗೊಳಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro സബ്സ്ക്രിപ്ഷനുകൾ സ്വയമായി പുനരാരംഭിക്കുന്നു. ഏത് സമയത്തും സെറ്റിംഗ്സ് → Apple ID → സബ്സ്ക്രിപ്ഷനുകൾ എന്നിവിടെ റദ്ദാക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Assinaturas Pro são renovadas automaticamente. Cancele a qualquer momento em Configurações → Apple ID → Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подписки Pro продлеваются автоматически. Отмените в любой момент в Настройках → Apple ID → Подписки."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro சந்தாக்கள் தானாக புதுப்பிக்கப்படும். Settings → Apple ID → Subscriptions இல் எந்த நேரத்திலும் ரத்து செய்யலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro సబ్‌స్క్రిప్షన్‌లు స్వయంచాలకంగా పునరావృతమవుతాయి. సెట్టింగ్‌లు → Apple ID → సబ్‌స్క్రిప్షన్‌లలో ఎప్పుడైనా రద్దు చేయండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pro 订阅自动续费。可在设置 → Apple ID → 订阅中随时取消。"
          }
        }
      }
    },
