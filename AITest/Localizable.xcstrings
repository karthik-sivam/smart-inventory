    "Use AI to take inventory faster — speak, photograph, or upload a sheet. Review everything before it's saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم AI لجرد أسرع — تحدث، صوّر، أو حمّل ورقة. راجع كل شيء قبل الحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutze AI, um schneller Inventur zu machen — sprechen, fotografieren oder ein Blatt hochladen. Überprüfe alles, bevor es gespeichert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa IA para hacer inventario más rápido — habla, fotografía o carga una hoja. Revisa todo antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez l'IA pour inventorier plus vite — parlez, photographiez ou importez une feuille. Vérifiez tout avant de sauvegarder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI से तेजी से इनवेंटरी लें — बोलें, फोटो लें, या शीट अपलोड करें। सेव होने से पहले सब कुछ रिव्यू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan AI untuk inventori lebih cepat — ucapkan, ambil foto, atau unggah lembar. Periksa semuanya sebelum disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AIを使用して在庫を高速化 — 音声、写真、またはシートをアップロード。保存前にすべてを確認します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI ಬಳಸಿ ಸ್ಟಾಕ್ ಎಣಿಕೆ ಬೇಗ ಮಾಡಿ — ಮಾತನಾಡಿ, ಛಾಯಾಚಿತ್ರ ತೆಗೆದುಕೊಳ್ಳಿ ಅಥವಾ ಶೀಟ್ ಅಪ್‌ಲೋಡ್ ಮಾಡಿ. ಸಂರಕ್ಷಿಸುವ ಮೊದಲು ಎಲ್ಲವನ್ನೂ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI ഉപയോഗിച്ച് സ്റ്റോക് കണക്ക് വേഗത്തിലാക്കുക — സംസാരിക്കുക, ഫോട്ടോ എടുക്കുക, അല്ലെങ്കിൽ ഷീറ്റ് അപ്‌ലോഡ് ചെയ്യുക. സ്വീകരിക്കുന്നതിന് മുമ്പ് എല്ലാം പരിശോധിക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use IA para fazer inventário mais rápido — fale, fotografe ou envie uma planilha. Revise tudo antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Используйте AI для быстрой инвентаризации — говорите, фотографируйте или загружайте таблицу. Проверьте всё перед сохранением."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI ஐப் பயன்படுத்தி விரைவாக பட்டியல் எடுக்கவும் — பேசவும், புகைப்படம் எடுக்கவும் அல்லது தாளை அப்லோட் செய்யவும். சேமிப்பதற்கு முன் எல்லாவற்றையும் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AI ఉపయోగించి ఇన్‌వెంటరీని వేగంగా తీసుకోండి — మాట్లాడండి, ఫోటో తీసుకోండి లేదా షీట్‌ను అప్‌లోడ్ చేయండి. సేవ్ చేసే ముందు ప్రతిదీ సమీక్షించండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
