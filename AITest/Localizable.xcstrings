    "Say what you sold. \"5 chips, 2 waters, 1 sandwich\". AI parses into a sale list." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قل ما بعت. \"5 شيبسي، 2 ماء، 1 ساندويش\". يحلل الذكاء الاصطناعي إلى قائمة مبيعات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sagen Sie, was Sie verkauft haben. \"5 Chips, 2 Wasser, 1 Sandwich\". KI analysiert in eine Verkaufsliste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di qué vendiste. \"5 papas, 2 aguas, 1 sándwich\". La IA analiza en una lista de ventas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dites ce que vous avez vendu. « 5 chips, 2 eaux, 1 sandwich ». L'IA analyse dans une liste de ventes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जो बेचा वो बोलें। \"5 चिप्स, 2 पानी, 1 सैंडविच\"। AI इसे बिक्री सूची में बदल देगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebutkan apa yang terjual. \"5 keripik, 2 air, 1 sandwich\". AI mengurai menjadi daftar penjualan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "売上を言ってください。「ポテチ5個、水2本、サンドイッチ1個」。AIが売上リストに解析します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನೀವು ಮಾರಿದ್ದನ್ನು ಹೇಳಿ. \"5 ಚಿಪ್ಸ್, 2 ನೀರು, 1 ಸ್ಯಾಂಡ್‌ವಿಚ್\". AI ಇದನ್ನು ಮಾರಾಟ ಪಟ್ಟಿಯಾಗಿ ಪರಿವರ್ತಿಸುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങൾ വിറ്റത് പറയുക. \"5 ചിപ്സ്, 2 വെള്ളം, 1 സാൻഡ്‌വിച്ച്\". AI ഇത് വിൽപന പട്ടികയാക്കും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diga o que você vendeu. \"5 salgadinhos, 2 águas, 1 sanduíche\". A IA analisa em uma lista de vendas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скажите, что продали. «5 чипсов, 2 воды, 1 бутерброд». ИИ составит список продаж."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நீங்கள் விற்றதை சொல்லுங்கள். \"5 சிப்ஸ், 2 தண்ணீர், 1 சாண்ட்விச்\". AI அதை விற்பனை பட்டியலாக மாற்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
