        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ವಿಜ್ಞಾಪನ ಮೊದಲ ಲೋಡ್‌ನಲ್ಲಿ Xcode ಕನ್ಸೋಲ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಸಾಧನ ID ಪರಿಶೀಲಿಸಿ. ಅದನ್ನು AdManager.swift ಗೆ ಅಂಟಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ads ആദ്യമായി ലോഡ് ചെയ്യുമ്പോൾ നിങ്ങളുടെ ഉപകരണ ID-യ്ക്കായി Xcode കൺസോൾ പരിശോധിക്കുക. ഇത് AdManager.swift-ൽ പേസ്റ്റ് ചെയ്യുക."
