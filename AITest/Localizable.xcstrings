          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഈ ഭാഷയിൽ വോയ്സ് കൗണ്ടിംഗ് ഇപ്പോൾ ലഭ്യമല്ല — ഫോട്ടോ അല്ലെങ്കിൽ ഷീറ്റ് ഉപയോഗിച്ച് നോക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
