          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಗೋದಾಮು, ಶೆಲ್ಫ್, ಫ್ರಿಡ್ಜ್, ಸ್ಟೋರ್‌ರೂಮ್ — ನಿಮ್ಮ ವ್ಯವಹಾರಕ್ಕೆ ಬೇಕಾದಷ್ಟು ಸ್ಟೋರೇಜ್ ಪ್ರದೇಶಗಳನ್ನು ರಚಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "വെയർഹൗസ്, ഷെൽഫ്, ഫ്രിഡ്ജ്, സ്റ്റോർറൂം — നിങ്ങളുടെ ബിസിനസിന് വേണ്ടത്ര സ്റ്റോറേജ് ഏരിയകൾ ഉണ്ടാക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Depósito, prateleira, geladeira, despensa — crie quantos armazéns sua empresa precisar."
