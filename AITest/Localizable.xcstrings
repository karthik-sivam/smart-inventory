        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encontrado en: %1$@%2$@. Editar esta plantilla no cambiará los artículos existentes — solo afecta los nuevos artículos creados a partir de ella en adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trouvé dans : %1$@%2$@. Modifier ce modèle ne changera pas ces articles existants — cela affecte uniquement les nouveaux articles créés à partir de celui-ci à l'avenir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यहाँ मिला: %1$@%2$@। इस टेम्पलेट को संपादित करने से वर्तमान आइटम नहीं बदलेंगे — यह केवल आगे से बनाई गई नई आइटम को प्रभावित करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ditemukan di: %1$@%2$@. Mengedit templat ini tidak akan mengubah item yang ada — hanya memengaruhi item baru yang dibuat darinya ke depannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@%2$@ に見つかりました。このテンプレートを編集しても、既存の商品には影響しません — 今後このテンプレートから作成される新しい商品にのみ適用されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಹುಡುಕಿದ್ದು: %1$@%2$@. ಈ ಮಾದರಿಯನ್ನು ಸಂಪಾದಿಸುವುದು ಆ ವಿದ್ಯಮಾನ ವಸ್ತುಗಳನ್ನು ಬದಲಾಯಿಸುವುದಿಲ್ಲ — ಇದು ಮುಂದಿನದಿಂದ ಮಾತ್ರ ಸೃಷ್ಟಿಸಿದ ನವ ವಸ್ತುಗಳ ಮೇಲೆ ಪ್ರಭಾವ ಬೀರುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@%2$@-ൽ കണ്ടെത്തി. ഈ ടെംപ്ലേറ്റ് എഡിറ്റ് ചെയ്യുന്നത് അവിടെയുള്ള ഇനങ്ങൾ മാറ്റില്ല — ഇത് മുന്നോട്ടുള്ള കാലത്ത് അതിൽ നിന്ന് സൃഷ്ടിച്ച പുതിയ ഇനങ്ങളെ മാത്രം ബാധിക്കുന്നു."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encontrado em: %1$@%2$@. Editar este modelo não alterará os itens existentes — afeta apenas novos itens criados a partir dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Найдено в: %1$@%2$@. Редактирование этого шаблона не изменит существующие товары — это повлияет только на новые товары, созданные на его основе."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இதில் காணப்படுகிறது: %1$@%2$@. இந்த வார்ப்புருவைத் திருத்துவது ஏற்கனவே உள்ள அந்த பொருட்களை மாற்றாது — இது இனிமேல் இதிலிருந்து உருவாக்கப்படும் புதிய பொருட்களை மட்டுமே பாதிக்கும்."
