        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಏನು ಸಂಭವಿಸಿದೆ ಅಥವಾ ನೀವು ಏನು ನೋಡಲು ಬಯಸುತ್ತೀರಿ ಎಂಬುದು ನಮಗೆ ತಿಳಿಸಿ."
