    "Add items to your inventory first, then you can record sales against them." : {
      "comment" : "A message displayed when a user tries to select an item from an empty inventory.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
