        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengubah %1$@ dari %2$@ menjadi %3$@ %4$@. Periksa ulang sebelum menyimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@を%2$@から%3$@ %4$@に変更します。保存前に確認してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ಅನ್ನು %2$@ ನಿಂದ %3$@ %4$@ ಗೆ ಬದಲಾಯಿಸಲಾಗುತ್ತಿದೆ. ಉಳಿಸುವ ಮೊದಲು ಪುನಃ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ %2$@-ൽ നിന്ന് %3$@ %4$@ ആയി മാറ്റുന്നു. സേവ് ചെയ്യുന്നതിന് മുമ്പ് വീണ്ടും പരിശോധിക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alterando %1$@ de %2$@ para %3$@ %4$@. Verifique antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изменение %1$@ с %2$@ на %3$@ %4$@. Проверьте перед сохранением."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ஐ %2$@ இலிருந்து %3$@ %4$@ ஆக மாற்றுகிறீர்கள். சேமிக்கும் முன் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ను %2$@ నుండి %3$@ %4$@కి మారుస్తున్నారు. సేవ్ చేయడానికి ముందు రెండుసార్లు తనిఖీ చేయండి."
