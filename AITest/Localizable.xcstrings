    "\"5 kg of flour, 3 bottles of olive oil, 2 boxes of sugar, and we're out of salt\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 كجم دقيق، 3 زجاجات زيت زيتون، صندوقي سكر، والملح انتهى\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 kg Mehl, 3 Flaschen Olivenöl, 2 Boxen Zucker, und Salz ist leer\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 kg de harina, 3 botellas de aceite de oliva, 2 cajas de azúcar, y no tenemos sal\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« 5 kg de farine, 3 bouteilles d'huile d'olive, 2 boîtes de sucre, et nous n'avons plus de sel »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 किग्रा मैदा, 3 बोतलें जैतून का तेल, 2 डिब्बे चीनी, और नमक खत्म हो गया\""
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 kg tepung, 3 botol minyak zaitun, 2 kotak gula, dan kami kehabisan garam\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「小麦粉5kg、オリーブオイル3本、砂糖2箱、塩は在庫なし」"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 ಕೆಜಿ ಹಿಟ್ಟು, 3 ಬಾಟಲಿ ಆಲಿವ್ ಆಯಿಲ್, 2 ಪೆಟ್ಟೆ ಸಕ್ಕರೆ, ಮತ್ತು ನಮಗೆ ಉಪ್ಪು ಇಲ್ಲ\""
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 കിലോ മാവ്, 3 കുപ്പി ജൈതൂന എണ്ണ, 2 പെട്ടി പഞ്ചസാര, ഉപ്പ് ശേഷിക്കുന്നില്ല\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 kg de farinha, 3 garrafas de azeite, 2 caixas de açúcar, e estamos sem sal\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 кг муки, 3 бутылки оливкового масла, 2 коробки сахара, и соль закончилась\""
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"மைதா 5 கிலோ, ஆலிவ் எண்ணெய் 3 பாட்டில், சர்க்கரை 2 பெட்டி, உப்பு இல்லை\""
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5 కిలోల밀flour, 3 బాటిల్‌ల olive oil, 2 బాక్సుల చక్కెర, మరియు ఉప్పు ఆయిపోయింది\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"5公斤面粉、3瓶橄榄油、2箱糖，缺盐\""
