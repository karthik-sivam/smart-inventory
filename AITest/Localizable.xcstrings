    "feedback.success.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم إرسال ملاحظاتك. نشكرك على وقتك في مساعدتنا على تحسين Stoqly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr Feedback wurde gesendet. Wir freuen uns, dass Sie uns helfen, Stoqly zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your feedback was sent. We appreciate you taking the time to help improve Stoqly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu comentario fue enviado. Agradecemos que dediques tiempo a ayudarnos a mejorar Stoqly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre avis a été envoyé. Nous apprécions que vous ayez pris le temps de nous aider à améliorer Stoqly."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपकी फीडबैक भेज दी गई है। Stoqly को बेहतर बनाने में मदद के लिए धन्यवाद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Feedback Anda telah terkirim. Kami menghargai waktu Anda membantu meningkatkan Stoqly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "フィードバックをお送りいただきありがとうございます。Stoqly の改善にご協力いただき感謝します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನಿಮ್ಮ ಪ್ರತಿಕ್ರಿಯೆ ಕಳುಹಿಸಲಾಗಿದೆ. Stoqly ಸುಧಾರಿಸಲು ನೀವು ತೆಗೆದುಕೊಂಡ ಸಮಯಕ್ಕೆ ನಾವು ನಿಮಗೆ ಕೃತಜ್ಞರು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങളുടെ പ്രതികരണം അയച്ചു. Stoqly മെച്ചപ്പെടുത്താൻ സാഹായ്യം ചെയ്യാൻ സമയം ചിലവഴിച്ചതിന് ഞങ്ങൾ നന്ദി പറയുന്നു."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seu feedback foi enviado. Agradecemos por ajudar a melhorar o Stoqly."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш отзыв отправлен. Спасибо, что помогаете улучшать Stoqly."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "உங்கள் பின்னூட்டம் அனுப்பப்பட்டது. Stoqly ஐ மேம்படுத்த உதவ நேரம் ஒதுக்கியதற்கு நாங்கள் நன்றியுடன் உள்ளோம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీ ప్రతిస్పందన పంపబడింది. Stoqly ని మెరుగుపరచడానికి సమయం కేటాయించినందుకు మేము కృతజ్ఞులు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "感谢您的反馈。我们很感激您花时间帮助我们改进 Stoqly。"
          }
        }
      }
    },
