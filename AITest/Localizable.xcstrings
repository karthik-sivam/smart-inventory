        }
      }
    },
    "Instead of a fixed quantity, you can set a percentage — e.g. 20% means you're alerted when stock falls below 20% of your maximum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بدلاً من كمية ثابتة، يمكنك تعيين نسبة مئوية — مثلاً 20%% يعني تنبيهك عند انخفاض المخزون عن 20%% من الحد الأقصى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anstelle einer festen Menge können Sie einen Prozentsatz festlegen – z. B. 20% bedeutet, dass Sie benachrichtigt werden, wenn der Bestand unter 20% Ihres Maximums fällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En lugar de una cantidad fija, puedes establecer un porcentaje — por ejemplo, 20% significa que recibirás una alerta cuando el stock caiga por debajo del 20% de tu máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au lieu d'une quantité fixe, vous pouvez définir un pourcentage — par exemple, 20 % signifie que vous êtes alerté lorsque le stock tombe en dessous de 20 % de votre maximum."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक तय मात्रा की बजाय, आप प्रतिशत सेट कर सकते हैं — जैसे 20% का मतलब है कि जब स्टॉक आपकी अधिकतम मात्रा के 20% से नीचे गिरेगा, तब आपको सूचना मिलेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alih-alih kuantitas tetap, Anda dapat mengatur persentase — misalnya 20% berarti Anda mendapat peringatan ketika stok turun di bawah 20% dari maksimum Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "固定数量の代わりに、パーセンテージを設定できます。例えば、20% は最大在庫の 20% を下回ったときにアラートが表示されることを意味します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಸ್ಥಿರ ಪ್ರಮಾಣದ ಬದಲು, ನೀವು ಶೇಕಡಾವಾರು ಹೊಂದಿಸಬಹುದು — ಉದಾ. 20% ಎಂದರೆ ನಿಮ್ಮ ಗರಿಷ್ಠ ಸ್ಟಾಕ್‌ನ 20% ಗಿಂತ ಕಡಿಮೆಯಾದಾಗ ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ಸಿಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "സ്ഥിരമായ അളവിന് പകരം ശതമാനം സെറ്റ് ചെയ്യാം — ഉദാ. 20% എന്നാൽ സ്റ്റോക്ക് നിങ്ങളുടെ പരമാവധിയുടെ 20%-ൽ താഴെയാകുമ്പോൾ അലേർട്ട് ലഭിക്കും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Em vez de uma quantidade fixa, você pode definir uma porcentagem — por exemplo, 20% significa que você recebe um alerta quando o estoque cai abaixo de 20% do seu máximo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вместо фиксированного количества можно установить процент — например, 20% означает, что вы получите оповещение, когда запас упадёт ниже 20% от максимума."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நிலையான அளவுக்கு பதிலாக, சதவீதத்தை அமைக்கலாம் — எ.கா. 20% என்பது உங்கள் அதிகபட்சத்தில் இருப்பு 20%-க்கு கீழே சென்றால் எச்சரிக்கை கிடைக்கும் என்று பொருள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "స్థిర పరిమాణానికి బదులుగా, మీరు శాతాన్ని సెట్ చేయవచ్చు — ఉదా. 20% అంటే స్టాక్ మీ గరిష్ఠంలో 20% కంటే తగ్గినప్పుడు మీకు హెచ్చరిక వస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "您可以设置百分比而不是固定数量——例如20%表示库存跌至最大值的20%以下时收到提醒。"
          }
        }
      }
    },
