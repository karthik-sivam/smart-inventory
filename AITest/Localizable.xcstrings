        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ನೀವು ಪ್ರೀತಿ ಮಾಡುವ ಅಥವಾ ನಾವು ಸುಧಾರಿಸಬಹುದಾದದನ್ನು ನಮಗೆ ತಿಳಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "നിങ്ങൾ എന്താണ് ഇഷ്ടപ്പെടുന്നതെന്നോ അല്ലെങ്കിൽ ഞങ്ങൾ എന്താ മെച്ചപ്പെടുത്താൻ കഴിയുമെന്നോ പറയുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nos conte o que você adora ou o que podemos melhorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Расскажите, что вам нравится или что можно улучшить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "நீங்கள் விரும்பியதை அல்லது நாம் மேம்படுத்தக்கூடியதை சொல்லுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీకు ఏది ఇష్టమైంది లేదా ఏది మెరుగుపరచవచ్చో చెప్పండి."
