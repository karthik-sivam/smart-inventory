        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$lld പരിഹരിക്കാത്ത ഇനം%2$@ ഇപ്പോഴും സ്വരൂപിതം ചെയ്യും — ലിങ്ക് ചെയ്യുന്നത് വരെ സ്റ്റോക്ക് കുറയ്ക്കില്ല."
