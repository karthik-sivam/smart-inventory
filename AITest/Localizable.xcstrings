    "feedback.message.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أخبرنا ماذا حدث أو ما تود أن ترى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erzählen Sie uns, was passiert ist oder was Sie sich wünschen."
