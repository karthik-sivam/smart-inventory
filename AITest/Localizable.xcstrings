          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "സ്മാർട്ട് കൗണ്ട് — വോയ്സ് തുറക്കുക. മൈക്രോഫോൺ ടാപ്പ് ചെയ്ത് നിങ്ങളുടെ ഐറ്റങ്ങൾ ഉച്ചത്തിൽ പറയുക, ഉദാ. 'അരി 5കിലോ, പാചക എണ്ണ 2 കുപ്പി'. AI അവ കണ്ടെത്തി ചേർക്കുന്നു."
