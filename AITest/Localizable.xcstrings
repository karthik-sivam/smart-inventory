        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "किसी भी स्टोरेज में जाएं, + बटन दबाएं, और आइटम की जानकारी भरें। नाम और विवरण अपने आप भरने के लिए आप बारकोड स्कैन कर सकते हैं।"
