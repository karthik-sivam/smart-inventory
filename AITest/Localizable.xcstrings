          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ದೈನಂದಿನ ಸಾರಾಂಶಗಳನ್ನು ನಿಲ್ಲಿಸಲು ಆಫ್ ಮಾಡಿ. ಕೆಳಗೆ ಸಕ್ರಿಯಗೊಳಿಸಿದ್ದರೆ Stoqly ಘೋಷಣೆಗಳು ಇನ್ನೂ ಕಾಣಿಸಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ദൈനിക സംഗ്രഹങ്ങൾ നിർത്താൻ ഇത് ഓഫ് ചെയ്യുക. Stoqly-ൽ നിന്നുള്ള പ്രഖ്യാപനങ്ങൾ താഴെ സജ്ജമാക്കിയിരുന്നാൽ ഇപ്പോഴും കാണപ്പെടാം."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
