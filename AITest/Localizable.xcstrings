          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "தினசரி சாராம்சங்களை நிறுத்த முடக்கவும். கீழே இயக்கினால் Stoqly யிலிருந்து அறிவிப்புகள் தோன்றலாம்."
