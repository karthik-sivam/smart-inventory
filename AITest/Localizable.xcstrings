            "value" : "वॉयस इन्वेंटरी के लिए माइक्रोफोन और स्पीच रिकग्निशन एक्सेस आवश्यक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Akses mikrofon dan pengenalan suara diperlukan untuk inventaris suara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音声在庫管理にはマイクと音声認識へのアクセスが必要です。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ವಾಕ್ ಇನ್ವೆಂಟರಿಗೆ ಮೈಕ್ರೋಫೋನ್ ಮತ್ತು ಭಾಷಣ ಗುರುತಿಸುವಿಕೆ ಪ್ರವೇಶ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "വോയ്സ് ഇൻവെന്ററിയ്ക്കായി മൈക്രോഫോൺ, സ്പീച്ച് സിദ്ധാന്തം ആക്സസ് ആവശ്യമാണ്."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acesso a microfone e reconhecimento de fala são necessários para inventário por voz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Требуется доступ к микрофону и распознаванию речи для голосового инвентаризации."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "குரல் இருப்பு பதிவுக்கு மைக்ரோஃபோன் மற்றும் பேச்சு அங்கீகார அணுகல் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "వాయిస్ ఇన్వెంటరీ కోసం మైక్రోఫోన్ మరియు ఆ ప్రకటన గుర్తింపు యాక్సెస్ అవసరం."
