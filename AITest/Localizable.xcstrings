    "onboarding.readyMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اضغط + لإضافة عنصرك الأول إلى %@،\nأو استكشف التطبيق بنفسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippe + um dein erstes Artikel zu %@ hinzuzufügen,\noder erkunde die App in deinem Tempo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap + to add your first item to %@,\nor explore the app at your own pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca + para agregar tu primer artículo a %@,\no explora la aplicación a tu ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Appuyez sur + pour ajouter votre premier article à %@,\nou explorez l'application à votre rythme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ में अपनी पहली वस्तु जोड़ने के लिए + दबाएं,\nया अपनी सुविधा अनुसार ऐप एक्सप्लोर करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketuk + untuk menambahkan item pertama Anda ke %@,\natau jelajahi aplikasi sesuai keinginan Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "+をタップして%@に最初の商品を追加するか、自分のペースでアプリを探索してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ಗೆ ನಿಮ್ಮ ಮೊದಲ ವಸ್ತುವನ್ನು ಸೇರಿಸಲು + ಒತ್ತಿ,\nಅಥವಾ ನಿಮ್ಮ ಸಮಯದಲ್ಲಿ ಆ್ಯಪ್ ಅನ್ವೇಷಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-ലേക്ക് നിങ്ങളുടെ ആദ്യ ഐറ്റം ചേർക്കാൻ + ടാപ്പ് ചെയ്യുക,\nഅല്ലെങ്കിൽ ആപ്പ് സ്വന്തം സമയത്ത് പര്യവേക്ഷണം ചെയ്യുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque + para adicionar seu primeiro item a %@,\nou explore o app no seu próprio ritmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нажмите +, чтобы добавить первый товар в %@,\nили изучайте приложение в свежем темпе."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ இல் உங்கள் முதல் பொருளைச் சேர்க்க + ஐத் தட்டவும்,\nஅல்லது உங்கள் நேரத்தில் ஆப்பை ஆராயுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "మీ మొదటి వస్తువును %@కి జోడించడానికి + నొక్కండి,\nలేదా మీ స్వంత వేగంతో యాప్‌ను అన్వేషించండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "点击 + 将第一个商品添加到 %@，\n或自己探索应用。"
          }
        }
      }
    },
