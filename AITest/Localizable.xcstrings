    "Found in: %@%@. Editing this template will not change those existing items — it only affects new items created from it going forward." : {
      "comment" : "A paragraph explaining that editing a template that is used by existing items will not change those items, but will affect new items created from it going forward.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
