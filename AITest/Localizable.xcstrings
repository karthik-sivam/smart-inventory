    "feedback.prompt.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أخبرنا ما تحب أو ما يمكننا تحسينه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sagen Sie uns, was Ihnen gefällt oder was wir verbessern können."
