    "Start by creating a storage area -- a room, shelf, warehouse, or any location where you keep stock." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ابدأ بإنشاء منطقة تخزين — غرفة أو رف أو مستودع أو أي موقع تحتفظ فيه بالمخزون."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beginnen Sie mit der Erstellung eines Lagerbereichs – ein Raum, Regal, Lager oder ein beliebiger Ort, an dem Sie Bestand lagern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comienza creando un área de almacenamiento -- una sala, estante, almacén, o cualquier lugar donde guardes stock."
