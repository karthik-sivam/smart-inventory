    "sale.negativeStock.warning" : {
      "comment" : "Warning message displayed in the UI when a sale batch results in negative stock for an item. The first argument is the name of the item. The second argument is the negative stock quantity, formatted with commas.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ في مخزون سالب الآن (%2$@). قد تكون فوتّ عملية جرد أو إدخال شراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ hat jetzt negativen Bestand (%2$@). Möglicherweise haben Sie eine Bestandszählung oder einen Einkaufseintrag vergessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is now at negative stock (%2$@). You may have missed a stock count or a purchase entry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ahora tiene stock negativo (%2$@). Es posible que hayas omitido un conteo de inventario o una entrada de compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ est maintenant en stock négatif (%2$@). Vous avez peut-être oublié un inventaire ou une entrée d'achat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ अभी नेगेटिव स्टॉक (%2$@) में है। शायद आपसे कोई स्टॉक काउंट या खरीद एंट्री छूट गई है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ sekarang stok negatif (%2$@). Anda mungkin melewatkan pencatatan stok atau entri pembelian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@は在庫不足（%2$@）になっています。棚卸しまたは仕入入力を見落とした可能性があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ಈಗ ಋಣಾತ್ಮಕ ಸ್ಟಾಕ್‌ನಲ್ಲಿದೆ (%2$@). ನೀವು ಸ್ಟಾಕ್ ಎಣಿಕೆ ಅಥವಾ ಖರೀದಿ ನಮೂದನ್ನು ತಪ್ಪಿಸಿರಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ഇപ്പോൾ നെഗറ്റീവ് സ്റ്റോക്കിലാണ് (%2$@). ഒരു സ്റ്റോക്ക് കൗണ്ട് അല്ലെങ്കിൽ പർച്ചേസ് എൻട്രി നിങ്ങൾക്ക് വിട്ടുപോയിരിക്കാം."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ agora está com estoque negativo (%2$@). Você pode ter perdido uma contagem de estoque ou um lançamento de compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ имеет отрицательный остаток (%2$@). Возможно, вы пропустили инвентаризацию или запись покупки."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ இப்போது எதிர்மறை இருப்பில் உள்ளது (%2$@). நீங்கள் ஒரு இருப்பு எண்ணிக்கை அல்லது கொள்முதல் பதிவை தவறவிட்டிருக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ఇప్పుడు నెగటివ్ స్టాక్‌లో ఉంది (%2$@). మీరు ఒక స్టాక్ కౌంట్ లేదా కొనుగోలు ఎంట్రీని మిస్ అయ్యి ఉండవచ్చు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@现在库存为负(%2$@)。您可能遗漏了库存盘点或采购记录。"
          }
        }
      }
    },
