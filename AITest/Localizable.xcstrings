        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Commencez par créer une zone de stockage -- une pièce, un rayonnage, un entrepôt, ou tout autre lieu où vous entreposez des stocks."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक स्टोरेज एरिया बनाकर शुरू करें -- कोई भी कमरा, शेल्फ, गोडाउन, या वह स्थान जहां आप स्टॉक रखते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mulai dengan membuat area penyimpanan -- ruangan, rak, gudang, atau lokasi mana pun tempat Anda menyimpan stok."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "まず保管エリア（部屋、棚、倉庫、または在庫を置いている場所）を作成してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಸಂಗ್ರಹ ಕ್ಷೇತ್ರ ರಚಿಸುವ ಮೂಲಕ ಪ್ರಾರಂಭ ಮಾಡಿ -- ಕೋಣೆ, ಶೆಲ್ಫ್, ಗೋದಾಮು, ಅಥವಾ ನೀವು ಸ್ಟಾಕ್ ಇರಿಸುವ ಯಾವುದೇ ಸ್ಥಳ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "സ്റ്റോറേജ് ഏരിയ സൃഷ്ടിക്കാൻ തുടങ്ങുക -- ഒരു മുറി, ഷെൽഫ്, വെയർഹൗസ്, അല്ലെങ്കിൽ നിങ്ങൾ സ്റ്റോക്ക് സൂക്ഷിക്കുന്ന ഏതെങ്കിലും സ്ഥാനം."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Comece criando uma área de armazenagem -- uma sala, prateleira, depósito ou qualquer local onde você guarda estoque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Начните с создания места хранения — комнаты, полки, склада или любого места, где вы держите товар."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "சேமிப்பு பகுதியை உருவாக்குவதன் மூலம் தொடங்கவும் -- அறை, அலமாரி, கிடங்கு அல்லது பங்குச் சேமிப்பு செய்யும் எந்த இடமும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఎందుకంటే స్టోరేజ్ ఎరియా సృష్టించడం ద్వారా ప్రారంభించండి -- ఒక గది, షెల్ఫ్, గిడ్డంగి, లేదా మీరు స్టాక్ ఉంచిన ఏదైనా స్థానం."
          }
