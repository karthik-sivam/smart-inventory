    "Are you sure you want to delete '%@'? This action cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هل تريد حقاً حذف '%@'؟ هذا الإجراء لا يمكن التراجع عنه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Möchten Sie '%@' wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Estás seguro de que deseas eliminar '%@'? Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Êtes-vous sûr de vouloir supprimer « %@ » ? Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्या आप '%@' को हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yakin ingin menghapus '%@'? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@'を削除してもよろしいですか?このアクションは取り消せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@' ಅನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಕ್ರಿಯೆ ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@' ഇല്ലാതാക്കാൻ നിങ്ങൾ ഉറപ്പാണോ? ഈ നടപടി പിന്നോട്ട് പോകാനാവില്ല."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tem certeza que deseja deletar '%@'? Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы уверены, что хотите удалить «%@»? Это действие нельзя отменить."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "உங்களுக்கு '%@' ஐ நீக்க விரும்பிறீர்களா? இந்த செயல் மீளாக்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@'ని తొలగించాలని మీరు ఖచ్చితంగా కోరుకుంటున్నారా? ఈ చర్య తిరిగి మార్చబడదు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "确定要删除'%@'吗？此操作无法撤销。"
          }
        }
      }
    },
    "Are you sure you want to delete '%@'? This will also delete all items in this storage." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هل تريد حقاً حذف '%@'؟ سيؤدي هذا إلى حذف جميع الأصناف في هذا المستودع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Möchten Sie '%@' wirklich löschen? Dies löscht auch alle Artikel in diesem Lager."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Estás seguro de que deseas eliminar '%@'? También se eliminarán todos los artículos en este almacén."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Êtes-vous sûr de vouloir supprimer « %@ » ? Cela supprimera aussi tous les articles dans cet emplacement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "क्या आप '%@' को हटाना चाहते हैं? इससे इस स्टोरेज के सभी आइटम भी हटा दिए जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yakin ingin menghapus '%@'? Ini juga akan menghapus semua item di gudang ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@'を削除してもよろしいですか?この保管場所のすべての品目も削除されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@' ಅನ್ನು ಅಳಿಸಲು ನೀವು ಖಚಿತವಾಗಿದ್ದೀರಾ? ಈ ಗೋದಾಮಿನ ಎಲ್ಲ ವಸ್ತುಗಳನ್ನೂ ಅಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@' ഇല്ലാതാക്കാൻ നിങ്ങൾ ഉറപ്പാണോ? ഇത് ഈ സംഭരണിയിലെ എല്ലാ ഇനങ്ങളും ഇല്ലാതാക്കും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tem certeza que deseja deletar '%@'? Isso também deletará todos os itens neste depósito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вы уверены, что хотите удалить «%@»? Это также удалит все товары на этом складе."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@' ஐ நிச்சயமாக நீக்க வேண்டுமா? இது இந்த சேமிப்பிடத்திலுள்ள அனைத்து பொருட்களையும் நீக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%@'ని తొలగించాలని మీరు ఖచ్చితంగా కోరుకుంటున్నారా? ఇది ఈ గోదామలోని అన్ని అంశాలను కూడా తొలగిస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "确定要删除'%@'吗？这也将删除此仓库中的所有项目。"
          }
        }
      }
    },
