    "Selling more than in stock (have: %@). Sale will record a negative stock." : {
      "comment" : "A note displayed in the checkout view when the user attempts to record a sale for more items than are currently in stock.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "البيع أكثر من المخزون (لديك: %@). سيتم تسجيل المبيعة برصيد سالب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verkauf übersteigt Bestand (vorhanden: %@). Verkauf wird mit negativem Bestand erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vendiendo más de lo que hay en stock (tienes: %@). La venta registrará stock negativo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vente supérieure au stock (disponible : %@). La vente enregistrera un stock négatif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्टॉक से ज्यादा बिक्री (%@ उपलब्ध है)। बिक्री नेगेटिव स्टॉक दर्ज करेगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menjual lebih banyak dari stok (tersedia: %@). Penjualan akan mencatat stok negatif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在庫を超える販売です（在庫: %@）。売上は負在庫として記録されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಸ್ಟಾಕ್‌ನಲ್ಲಿ ಹೆಚ್ಚಿನದನ್ನು ಮಾರುತ್ತಿರುವುದು (ಹೊಂದಿರುವುದು: %@). ಮಾರಾಟ ಋಣಾತ್ಮಕ ಸ್ಟಾಕ್ ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "സ്റ്റോക്കിനേക്കാൾ കൂടുതൽ വിൽക്കുന്നു (ഉണ്ടായിരിക്കുന്നത്: %@). വിൽപ്പനം നെഗറ്റീവ് സ്റ്റോക്ക് രേഖപ്പെടുത്തും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vendendo mais do que em estoque (tem: %@). A venda registrará um estoque negativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Продажа больше, чем в наличии (есть: %@). Продажа создаст отрицательный остаток."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இருப்பை விட அதிகம் விற்கிறீர்கள் (உள்ளது: %@). விற்பனை எதிர்மறை இருப்பை பதிவு செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "స్టాక్‌లో ఉన్నవారి కంటే ఎక్కువ విక్రయం చేస్తోంది (ఉన్నవారు: %@). విక్రయం ప్రతికూల స్టాక్‌ను రికార్డ్ చేస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "销售数量超过库存（现有：%@）。此笔销售将记录负库存。"
          }
        }
      }
    },
