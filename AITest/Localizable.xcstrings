            "value" : "موجود في: %1$@%2$@. تعديل هذا القالب لن يغير العناصر الموجودة — يؤثر فقط على العناصر الجديدة التي يتم إنشاؤها منه لاحقاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gefunden in: %1$@%2$@. Das Bearbeiten dieser Vorlage ändert nicht diese vorhandenen Artikel — es betrifft nur neue Artikel, die ab sofort daraus erstellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Found in: %1$@%2$@. Editing this template will not change those existing items — it only affects new items created from it going forward."
