    "Photo: point at a shelf to count automatically. Voice: speak your items aloud. Sheet: scan a printed list." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الصورة: وجّه الكاميرا نحو الرف للعد التلقائي. الصوت: تحدث عن الأصناف بصوت عالٍ. الورقة: امسح قائمة مطبوعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Foto: Regal anzielen zum automatischen Zählen. Sprache: Artikel laut aussprechen. Blatt: gedruckte Liste scannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Foto: apunta a un estante para contar automáticamente. Voz: di tus artículos en voz alta. Hoja: escanea una lista impresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Photo : pointez une étagère pour compter automatiquement. Voix : énoncez vos articles à haute voix. Feuille : scannez une liste imprimée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "फ़ोटो: स्वचालित गिनती के लिए शेल्फ पर पॉइंट करें। Voice: अपनी वस्तुएं ज़ोर से बोलें। Sheet: मुद्रित सूची स्कैन करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Foto: arahkan ke rak untuk menghitung secara otomatis. Suara: ucapkan item Anda dengan lantang. Lembar: pindai daftar cetak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "写真：棚に向けて自動的にカウント。音声：商品を声で読み上げ。シート：印刷されたリストをスキャン。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಫೋಟೋ: ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಎಣಿಸಲು ಶೆಲ್ಫ್‌ನತ್ತ ತೋರಿಸಿ. ಧ್ವನಿ: ನಿಮ್ಮ ವಸ್ತುಗಳನ್ನು ಪರ ಚಿಹ್ನೆ ಓದಿ. ಶೀಟ್: ಮುದ್ರಿತ ಪಟ್ಟಿ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഫോട്ടോ: ഷെൽഫിൽ ചൂണ്ടി സ്വയമായി എണ്ണുക. വോയിസ്: നിങ്ങളുടെ ഇനങ്ങൾ ഉച്ചത്തിൽ പറയുക. ഷീറ്റ്: അച്ചടിച്ച ലിസ്റ്റ് സ്കാൻ ചെയ്യുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Foto: aponte para uma prateleira para contar automaticamente. Voz: fale seus itens em voz alta. Planilha: digitalize uma lista impressa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Фото: наведите на полку для автоматического подсчета. Голос: называйте товары вслух. Лист: отсканируйте печатный список."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "புகைப்படம்: தட்டுக்கு சுட்டி வைத்து தானாக எண்ணவும். குரல்: உங்கள் பொருட்களை நரம்பிற்று சொல்லவும். தாள்: அச்சிடப்பட்ட பட்டியலை ஸ்கேன் செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఫోటో: స్వయంచాలకంగా లెక్కించడానికి చేపట్టిన వద్ద సూచించండి. వాయిస్: మీ అంశాలను చెప్పండి. షీట్: ముద్రిత జాబితాను స్కాన్ చేయండి."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拍照：对着货架自动盘点。语音：口头报告商品。表单：扫描打印清单。"
          }
        }
      }
    },
    "Photograph a handwritten chit, receipt, or invoice. AI reads every line." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صوّر ملاحظة مكتوبة بخط اليد أو إيصالاً أو فاتورة. الذكاء الاصطناعي يقرأ كل سطر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografieren Sie einen handschriftlichen Zettel, eine Quittung oder Rechnung. KI liest jede Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografía un apunte manuscrito, recibo o factura. La IA lee cada línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Photographiez un reçu manuscrit, un bon ou une facture. L'IA lit chaque ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हाथ से लिखी पर्ची, रसीद, या इनवॉइस की फोटो लें। AI हर लाइन पढ़ता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potret catatan tulis tangan, kwitansi, atau faktur. AI membaca setiap baris."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "手書きのメモ、レシート、または請求書を撮影。AIがすべての行を読み取ります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಕೈಬರಹದ ಚೀಟಿ, ರಸೀದಿ ಅಥವಾ ಇನ್‌ವಾಯ್ಸ್ ಫೋಟೋ ತೆಗೆಯಿರಿ. AI ಪ್ರತಿ ಸಾಲನ್ನೂ ಓದುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "കൈയെഴുത്ത് ചീട്ട്, രസീത്, അല്ലെങ്കിൽ ഇൻവോയ്സ് ഫോട്ടോ എടുക്കുക. AI ഓരോ വരിയും വായിക്കും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografe um bilhete manuscrito, recibo ou nota fiscal. A IA lê cada linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сфотографируйте рукописную записку, квитанцию или счет. ИИ прочитает каждую строку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "கையால் எழுதிய சீட்டு, ரசீது அல்லது இன்வாய்ஸை புகைப்படம் எடுக்கவும். AI ஒவ்வொரு வரியையும் படிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "చేతిరాత చీటీ, రసీదు, లేదా ఇన్వాయిస్‌ను ఫోటో తీయండి. AI ప్రతి లైనూ చదువుతుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拍照手写单据、收据或发票。AI逐行识别。"
          }
        }
      }
    },
    "Photograph a handwritten or printed inventory list. AI extracts all rows for you to review." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "صوّر قائمة مخزون مكتوبة بخط اليد أو مطبوعة. الذكاء الاصطناعي يستخرج جميع الصفوف لمراجعتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografieren Sie eine handschriftliche oder gedruckte Bestandsliste. KI extrahiert alle Zeilen zur Überprüfung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografía una lista de inventario manuscrita o impresa. La IA extrae todas las filas para que las revises."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Photographiez une liste de stock manuscrite ou imprimée. L'IA en extrait tous les éléments pour votre vérification."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हाथ से लिखी या प्रिंटेड इन्वेंटरी लिस्ट की फोटो लें। AI सभी रो निकालकर आपको दिखाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potret daftar inventaris tulisan tangan atau cetak. AI ekstrak semua baris untuk Anda tinjau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "手書きまたは印刷された在庫リストを撮影。AIがすべての行を抽出して確認します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಕೈಬರಹ ಅಥವಾ ಮುದ್ರಿತ ಇನ್ವೆಂಟರಿ ಪಟ್ಟಿಯ ಫೋಟೋ ತೆಗೆಯಿರಿ. AI ಎಲ್ಲಾ ಸಾಲುಗಳನ್ನು ಪರಿಶೀಲನೆಗಾಗಿ ಹೊರತೆಗೆಯುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "കൈയെഴുത്തോ പ്രിന്റ് ചെയ്തതോ ആയ ഇൻവെന്ററി ലിസ്റ്റ് ഫോട്ടോ എടുക്കുക. AI എല്ലാ വരികളും എക്സ്ട്രാക്ട് ചെയ്ത് നിങ്ങൾക്ക് പരിശോധിക്കാൻ നൽകും."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fotografe uma lista de inventário manuscrita ou impressa. A IA extrai todas as linhas para sua revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сфотографируйте рукописный или печатный список товаров. ИИ извлечет все строки для проверки."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "கையால் எழுதிய அல்லது அச்சிடப்பட்ட இருப்பு பட்டியலை புகைப்படம் எடுக்கவும். AI அனைத்து வரிகளையும் பிரித்தெடுத்து பரிசீலனைக்கு தரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "చేతిరాత లేదా ప్రింటెడ్ ఇన్వెంటరీ జాబితాను ఫోటో తీయండి. AI అన్ని వరుసలను సమీక్ష కోసం సేకరిస్తుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拍照手写或印刷的库存清单。AI提取所有行供您审核。"
          }
        }
      }
    },
