    "quickCount.largeChangeConfirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تغيير %1$@ من %2$@ إلى %3$@ %4$@. تحقق جيداً قبل الحفظ."
