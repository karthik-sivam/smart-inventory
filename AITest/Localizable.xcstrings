    "Say each item with quantity and price, e.g. \"5 chips at 10, 2 waters at 20\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قل كل منتج مع الكمية والسعر، مثلاً \"5 شيبسي بـ 10، عبوتي ماء بـ 20\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sage jeden Artikel mit Menge und Preis, z. B. \"5 Chips zu 10, 2 Wasser zu 20\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di cada artículo con cantidad y precio, p. ej. \"5 papas a 10, 2 aguas a 20\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Énoncez chaque article avec quantité et prix, par exemple « 5 chips à 10, 2 eaux à 20 »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "प्रत्येक आइटम मात्रा और कीमत के साथ बोलें, उदाहरण के लिए \"5 chips 10 पर, 2 waters 20 पर\""
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sebutkan setiap item dengan jumlah dan harga, misalnya \"5 keripik 10, 2 air 20\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "商品名と数量・価格を読み上げてください。例：「チップス5個10円、水2本20円」"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಪ್ರತಿ ವಸ್ತುವನ್ನು ಪ್ರಮಾಣ ಮತ್ತು ಬೆಲೆಯೊಂದಿಗೆ ಹೇಳಿ, ಉದಾಹರಣೆಗೆ \"5 ಚಿಪ್ಸ್ 10ಕ್ಕೆ, 2 ನೀರುಗಳು 20ಕ್ಕೆ\""
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഓരോ ഇനവും അളവും വിലയും പറയുക, ഉദാഹരണത്തിന് \"5 ചിപ്സ് 10-ൽ, 2 വെള്ളം 20-ൽ\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diga cada item com quantidade e preço, ex. \"5 salgadinhos a 10, 2 águas a 20\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Назовите каждый товар с количеством и ценой, например «5 чипсов по 10, 2 воды по 20»"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஒவ்வொரு பொருளையும் அளவு மற்றும் விலை மூலம் சொல்லவும், எ.கா. \"5 chips at 10, 2 waters at 20\""
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ప్రతి వస్తువును పరిమాణం మరియు ధరతో చెప్పండి, ఉదాహరణకు \"5 చిప్‌లు 10కి, 2 వాటర్‌లు 20కి\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "说出每件物品的数量和价格，例如“5包薯片每个10，2瓶水每个20”"
          }
        }
      }
