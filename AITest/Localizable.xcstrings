    "Add your first item using the + button above,\nor tap into a storage to add items there." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف عنصرك الأول باستخدام الزر + أعلاه،\nأو اضغط على مستودع لإضافة عناصر هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge deinen ersten Artikel mit dem ＋-Button oben hinzu,\noder tippe auf ein Lager, um dort Artikel hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agrega tu primer artículo usando el botón + arriba,\no toca un almacén para agregar artículos allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoutez votre premier article en utilisant le bouton + ci-dessus,\nou appuyez sur un emplacement pour y ajouter des articles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऊपर + बटन का उपयोग करके अपनी पहली वस्तु जोड़ें,\nया किसी स्टोरेज में वस्तुएं जोड़ने के लिए टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tambahkan item pertama Anda menggunakan tombol + di atas,\natau ketuk penyimpanan untuk menambah item di sana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上の＋ボタンを使って最初のアイテムを追加するか、\n保管場所をタップしてそこにアイテムを追加してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಮೇಲಿನ + ಬಟನ್ ಬಳಸಿ ನಿಮ್ಮ ಮೊದಲ ವಸ್ತು ಸೇರಿಸಿ,\nಅಥವಾ ಗೋದಾಮುವಿಗೆ ನಕ್ಕಿ ಅಲ್ಲಿ ವಸ್ತುಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "മുകളിലുള്ള + ബട്ടൺ ഉപയോഗിച്ച് നിങ്ങളുടെ ആദ്യ ഇനം ചേർക്കുക,\nഅല്ലെങ്കിൽ സംഭരണത്തിൽ ട്യാപ് ചെയ്ത് ഇനങ്ങൾ ചേർക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Adicione seu primeiro item usando o botão + acima,\nou toque em um armazém para adicionar itens lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Добавьте первый товар, нажав кнопку + выше,\nили перейдите на склад, чтобы добавить товары там."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "மேலே உள்ள + பொத்தானைப் பயன்படுத்தி முதல் உருப்படியைச் சேர்க்கவும்,\nஅல்லது சேமிப்பிடத்தில் தட்டி உருப்படிகளைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "పై + బటన్‌ను ఉపయోగించి మీ మొదటి వస్తువును జోడించండి,\nలేదా అక్కడ వస్తువులను జోడించడానికి స్టోరేజ్‌లోకి నొక్కండి."
          }
        },
        "zh-Hans" : {
