    "%@ has invited you to their Stoqly workspace as %@." : {
      "comment" : "A message shown in an alert when a user is invited to join a team. The first argument is the name of the user who invited the other user. The second argument is the role the invited user will have in the team.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ دعاك للانضمام إلى مساحة عمل Stoqly الخاصة به كـ %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ hat dich zu ihrem Stoqly-Arbeitsbereich als %2$@ eingeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has invited you to their Stoqly workspace as %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ te ha invitado a su espacio de trabajo en Stoqly como %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ vous a invité à son espace de travail Stoqly en tant que %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ने आपको उनके Stoqly कार्यक्षेत्र में %2$@ के रूप में आमंत्रित किया है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ mengundang Anda ke ruang kerja Stoqly mereka sebagai %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@があなたをStoqlyワークスペースに%2$@として招待しました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ನಿಮ್ಮನ್ನು ತಮ್ಮ Stoqly ವರ್ಕ್‌ಸ್ಪೇಸ್‌ಗೆ %2$@ ಆಗಿ ಆಹ್ವಾನ ಮಾಡಿದ್ದಾರೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ നിങ്ങളെ അവരുടെ Stoqly ഭാഗ്യപ്രവാഹത്തിലേക്ക് %2$@ ആയി ക്ഷണിച്ചിരിക്കുന്നു."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ convidou você para seu espaço de trabalho Stoqly como %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ пригласил вас в рабочее пространство Stoqly как %2$@."
