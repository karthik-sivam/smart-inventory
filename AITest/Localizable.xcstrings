        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "任意の保管場所に移動し、+ボタンをタップしてアイテムの詳細を入力します。バーコードをスキャンして名前と詳細を自動入力することもできます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಯಾವುದೇ ಸ್ಟೋರೇಜ್‌ಗೆ ಹೋಗಿ, + ಬಟನ್ ಒತ್ತಿ, ಮತ್ತು ವಸ್ತುವಿನ ವಿವರಗಳನ್ನು ಭರ್ತಿ ಮಾಡಿ. ಹೆಸರು ಮತ್ತು ವಿವರಗಳನ್ನು ಸ್ವಯಂ ಭರ್ತಿ ಮಾಡಲು ನೀವು ಬಾರ್‌ಕೋಡ್ ಸ್ಕ್ಯಾನ್ ಮಾಡಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ഏതെങ്കിലും സ്റ്റോറേജിലേക്ക് പോയി + ബട്ടൺ ടാപ്പ് ചെയ്ത് ഇനത്തിന്റെ വിവരങ്ങൾ നൽകുക. പേരും വിവരങ്ങളും ഓട്ടോ ഫിൽ ചെയ്യാൻ ബാർകോഡ് സ്കാൻ ചെയ്യാം."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vá para qualquer Armazém, toque no botão +, e preencha os detalhes do item. Você pode escanear um código de barras para preencher automaticamente o nome e os detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перейдите на любой склад, нажмите кнопку + и заполните сведения товара. Вы можете отсканировать штрихкод, чтобы автоматически заполнить название и детали."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "எந்த சேமிப்பகத்திற்கும் சென்று, + பொத்தானை தட்டி, பொருள் விவரங்களை நிரப்பவும். பெயர் மற்றும் விவரங்களை தானாக நிரப்ப பார்கோடை ஸ்கேன் செய்யலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ఏదైనా స్టోరేజ్‌కి వెళ్లి, + బటన్ నొక్కి, వస్తువు వివరాలను నింపండి. పేరు మరియు వివరాలను ఆటోమేటిక్‌గా నింపడానికి బార్‌కోడ్‌ను స్కాన్ చేయవచ్చు."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
