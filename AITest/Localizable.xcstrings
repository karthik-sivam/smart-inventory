          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "まず在庫にアイテムを追加してから、それに対して売上を記録できます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಮೊದಲು ನಿಮ್ಮ ಸಾಮಗ್ರೀಗೆ ವಸ್ತುಗಳನ್ನು ಸೇರಿಸಿ, ತದನಂತರ ನೀವು ಅವುಗಳ ವಿರುದ್ಧ ಮಾರಾಟ ದಾಖಲಿಸಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ആദ്യം നിങ്ങളുടെ ഇൻവെന്ററിയിലേക്ക് ഇനങ്ങൾ ചേർക്കുക, തുടർന്ന് അവയ്ക്കെതിരെ വിറ്റുവരവ് രേഖപ്പെടുത്താം."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
