        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mengubah %1$@ dari %2$@ ke %3$@ %4$@. Periksa kembali sebelum menyimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@を%2$@から%3$@ %4$@に変更しています。保存する前に確認してください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ನ್ನು %2$@ದಿಂದ %3$@ %4$@ಗೆ ಬದಲಾಯಿಸಲಾಗುತ್ತಿದೆ. ಉಳಿಸುವ ಮೊದಲು ಪುನಃ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ആയി %2$@ മുതൽ %3$@ %4$@ ആയി മാറ്റുകയാണ്. സംരക്ഷിക്കുന്നതിനു മുമ്പ് വീണ്ടും പരിശോധിക്കുക."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alterando %1$@ de %2$@ para %3$@ %4$@. Verifique antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изменение %1$@ с %2$@ на %3$@ %4$@. Проверьте перед сохранением."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ ஐ %2$@ இலிருந்து %3$@ %4$@ ஆக மாற்றுகிறது. சேமிக்கும் முன் மீண்டும் சரிபார்க்கவும்."
