    "Include quantity and price. One item per line works best." : {
      "comment" : "A description under the text editor, explaining how to format the sales data correctly.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أضف الكمية والسعر. عنصر واحد لكل سطر أفضل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Menge und Preis eintragen. Ein Artikel pro Zeile ist optimal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Incluye cantidad y precio. Un artículo por línea funciona mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Incluez la quantité et le prix. Un article par ligne est préférable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "मात्रा और कीमत शामिल करें। प्रति पंक्ति एक वस्तु सर्वोत्तम है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sertakan jumlah dan harga. Satu item per baris paling efektif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "数量と価格を含めてください。1行に1アイテムが最適です。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ಪ್ರಮಾಣ ಮತ್ತು ಬೆಲೆ ಸೇರಿಸಿ. ಒಂದು ಪಾಲಿನಲ್ಲಿ ಒಂದು ಐಟಂ ಸುಲಭವಾಗಿರುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "അളവും വില ഉൾപ്പെടുത്തുക. ഓരോ വരിയിലും ഒരു ഇനം നല്ലതാണ്."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclua quantidade e preço. Um item por linha funciona melhor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Укажите количество и цену. Один товар в строке — оптимально."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "அளவு மற்றும் விலை சேர்க்கவும். ஒரு வரிக்கு ஒரு பொருள் சிறந்தது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "పరిమాణం మరియు ధరను చేర్చండి. ఒక్క అంశానికి ఒక్క లైన్ ఉత్తమంగా ఉంటుంది."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请包含数量和价格。每行一件商品效果最佳。"
          }
        }
      }
    },
